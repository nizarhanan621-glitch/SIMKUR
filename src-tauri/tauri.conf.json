
{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SIMKUR",
  "version": "0.1.0",
  "identifier": "id.simkur.smp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SIMKUR",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NkZERjdGODRBMUE4RDIKUldUU3FLR0VmOTl2bE8waVFRdG01d1ljbnRXOUM5Z0NDSDl2M01PK3pnaTZjbnB0RWdocCtTR2wK",
      "endpoints": [
        "https://github.com/nizarhanan621-glitch/SIMKUR/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
